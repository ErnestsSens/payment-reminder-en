# Full path to the Google service account JSON file:
#   GOOGLE_CREDENTIALS=/Users/username/secrets/service-account.json
# The spreadsheet must grant Editor rights to the service account email!
GOOGLE_CREDENTIALS=

# Google Sheets file ID (from the URL: docs.google.com/spreadsheets/d/<THIS>/edit)
SPREADSHEET_ID=

# Text2Reach API key
TEXT2REACH_KEY=

# GNL Discord bot
DISCORD_BOT_URL=
DISCORD_BOT_KEY=

# Park managers' Discord IDs; separate multiple IDs for one park with commas
JUGLA_MANAGER_DISCORD_IDS=
MEZAPARKS_MANAGER_DISCORD_IDS=
SAMPETERIS_MANAGER_DISCORD_IDS=
GALERIJA_CENTRS_MANAGER_DISCORD_IDS=
GNL_MANAGER_DISCORD_IDS=

# Shared recipients of finance and management notifications
FINANCE_DISCORD_IDS=
MANAGEMENT_DISCORD_IDS=

# For testing: true = sends nothing, only prints to the console
SMS_MOCK=false
DISCORD_MOCK_MESSAGES=false
